<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- React 和 ReactDOM -->
    <script src="/js/react/react.production.min.js"></script>
    <script src="/js/react/react-dom.production.min.js"></script>

    <!-- Babel -->
    <script src="/js/react/babel.min.js"></script>

    <!-- React Bootstrap -->
    <link rel="stylesheet" href="/css/bootstrap5.min.css">
    <script src="/js/react/react-bootstrap.min.js"></script>

    <!-- 其他依赖 -->
    <link href="/css/toast.css" rel="stylesheet">
    <link href="/css/simplemde.min.css" rel="stylesheet">
    <link href="/css/github.min.css" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">
    <div id="root">
        <!-- React 将在这里渲染应用 -->
    </div>

    <!-- 必要的脚本 -->
    <script src="/js/qrcode.min.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/simplemde.min.js"></script>
    <script src="/js/marked.min.js"></script>
    <script src="/js/highlight.min.js"></script>

    <!-- React 组件代码 -->
    <script type="text/babel">
        // 解构需要用到的 React Bootstrap 组件
        const {
            Container, Row, Col, Card, Form, Button,
            Badge, Modal, Alert, ButtonGroup
        } = ReactBootstrap;

        // 防抖函数
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // 文件类型图标组件
        const FileTypeBadge = ({ fileType, contentType }) => {
            let badgeClass = "text-xs px-2 py-1 rounded-full ml-2";

            if (contentType === 'markdown') {
                return <span className={`${badgeClass} bg-purple-500 text-white`}>Markdown</span>;
            }

            switch (fileType) {
                case 'image':
                    return <span className={`${badgeClass} bg-green-500 text-white`}>图片</span>;
                case 'video':
                    return <span className={`${badgeClass} bg-red-500 text-white`}>视频</span>;
                case 'audio':
                    return <span className={`${badgeClass} bg-blue-400 text-white`}>音频</span>;
                case 'pdf':
                    return <span className={`${badgeClass} bg-orange-500 text-white`}>PDF</span>;
                case 'text':
                    return <span className={`${badgeClass} bg-gray-500 text-white`}>文本</span>;
                default:
                    return <span className={`${badgeClass} bg-gray-500 text-white`}>其他</span>;
            }
        };

        // 文件预览组件
        const FilePreview = ({ file }) => {
            if (file.type !== 'file') return null;

            const downloadUrl = `/download/${file.id}`;

            switch (file.fileType) {
                case 'image':
                    return (
                        <div className="mt-3">
                            <img src={downloadUrl} className="max-w-full h-auto rounded" alt={file.name} />
                        </div>
                    );
                case 'video':
                    return (
                        <div className="mt-3">
                            <video
                                src={downloadUrl}
                                className="max-w-full rounded"
                                controls
                                preload="metadata"
                            ></video>
                        </div>
                    );
                case 'audio':
                    return (
                        <div className="mt-3">
                            <audio
                                src={downloadUrl}
                                className="w-full"
                                controls
                            ></audio>
                        </div>
                    );
                case 'pdf':
                    return (
                        <div className="mt-3">
                            <iframe
                                src={downloadUrl}
                                className="w-full h-96 rounded border"
                                title={file.name}
                            ></iframe>
                        </div>
                    );
                default:
                    return (
                        <div className="text-center mt-3">
                            <a
                                href={downloadUrl}
                                className="inline-block px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 transition"
                            >
                                下载文件
                            </a>
                        </div>
                    );
            }
        };

        // 文件项组件
        const FileItem = ({ file, onDelete, onEdit }) => {
            const [isEditing, setIsEditing] = React.useState(false);
            const [editContent, setEditContent] = React.useState(file.content || '');

            const handleEditSubmit = (e) => {
                e.preventDefault();
                onEdit(file.id, editContent);
                setIsEditing(false);
            };

            return (
                <div className="bg-white rounded-lg shadow-sm p-3 sm:p-4 mb-4">
                    {/* 文件头部信息 - 在移动设备上垂直排列 */}
                    <div className="flex flex-col sm:flex-row sm:justify-between sm:items-center">
                        <div className="mb-2 sm:mb-0">
                            <div className="flex flex-wrap items-center">
                                <span className="font-semibold text-base break-all mr-2">{file.name}</span>
                                {file.type === 'file' ? (
                                    file.fileType && <FileTypeBadge fileType={file.fileType} />
                                ) : (
                                    <FileTypeBadge contentType={file.contentType} />
                                )}
                            </div>
                            <div className="text-gray-500 text-xs sm:text-sm mt-1 break-words">
                                <span className="block sm:inline">分享者: {file.username}</span>
                                <span className="hidden sm:inline"> | </span>
                                <span className="block sm:inline">时间: {new Date(file.uploadTime).toLocaleString()}</span>
                                {file.updateTime && (
                                    <>
                                        <span className="hidden sm:inline"> | </span>
                                        <span className="block sm:inline">更新于: {new Date(file.updateTime).toLocaleString()}</span>
                                    </>
                                )}
                            </div>
                        </div>
                        <div className="flex mt-2 sm:mt-0">
                            {file.type === 'text' && (
                                <button
                                    className="px-3 py-1 border border-blue-300 text-blue-500 rounded mr-2 text-sm hover:bg-blue-50 transition"
                                    onClick={() => setIsEditing(true)}
                                >
                                    编辑
                                </button>
                            )}
                            <button
                                className="px-3 py-1 border border-red-300 text-red-500 rounded text-sm hover:bg-red-50 transition"
                                onClick={() => onDelete(file.id)}
                            >
                                删除
                            </button>
                        </div>
                    </div>

                    {file.type === 'file' ? (
                        <FilePreview file={file} />
                    ) : isEditing ? (
                        <form onSubmit={handleEditSubmit} className="mt-3">
                            <textarea
                                className="w-full border rounded p-2"
                                rows={5}
                                value={editContent}
                                onChange={(e) => setEditContent(e.target.value)}
                            />
                            <div className="mt-2 flex justify-end">
                                <button
                                    type="submit"
                                    className="px-3 py-1 bg-blue-500 text-white rounded text-sm hover:bg-blue-600 transition mr-2"
                                >
                                    保存
                                </button>
                                <button
                                    type="button"
                                    className="px-3 py-1 bg-gray-200 text-gray-700 rounded text-sm hover:bg-gray-300 transition"
                                    onClick={() => setIsEditing(false)}
                                >
                                    取消
                                </button>
                            </div>
                        </form>
                    ) : (
                        <div className={`mt-3 overflow-x-auto ${file.contentType === 'markdown' ? 'markdown-content' : 'whitespace-pre-wrap'}`}>
                            {file.contentType === 'markdown' ? (
                                <div dangerouslySetInnerHTML={{
                                    __html: marked.parse(file.content)
                                }} />
                            ) : (
                                file.content
                            )}
                        </div>
                    )}
                </div>
            );
        };

        // 文件列表样式
        const FileList = ({ files, onDelete, onEdit }) => {
            return (
                <div className="space-y-4">
                    {files.length > 0 ? (
                        files.map(file => (
                            <FileItem
                                key={file.id}
                                file={file}
                                onDelete={onDelete}
                                onEdit={onEdit}
                            />
                        ))
                    ) : (
                        <div className="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4 rounded">
                            还没有共享的文件或文本，快来分享吧！
                        </div>
                    )}
                </div>
            );
        };

        // 成员列表组件
        const MembersList = ({ members }) => {
            return (
                <div className="mt-6 bg-white rounded-lg shadow-sm p-4">
                    <div className="flex justify-between items-center mb-3">
                        <span className="text-lg font-semibold">当前在线成员 ({members.length})</span>
                        <span className="bg-green-500 text-white text-xs px-2 py-1 rounded-full">
                            {members.length} 人在线
                        </span>
                    </div>
                    {members.length > 0 ? (
                        <div className="space-y-2">
                            {members.map(member => (
                                <div key={member.id} className="bg-gray-50 p-2 rounded">
                                    <div className="flex justify-between items-center">
                                        <div>
                                            <span className="font-medium">{member.name}</span>
                                            <span className="text-gray-500 text-sm ml-2">({member.ip})</span>
                                        </div>
                                        <span className="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full">
                                            {new Date(member.connectTime).toLocaleTimeString()}
                                        </span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div className="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-2 rounded text-sm">
                            暂无其他成员在线
                        </div>
                    )}
                </div>
            );
        };

        // App 组件
        function App() {
            const [files, setFiles] = React.useState([]);
            const [members, setMembers] = React.useState([]);
            const [settings, setSettings] = React.useState({
                ip: 'localhost',
                port: 5421,
                uploadPath: '',
                authEnable: false,
                password: '',
                chunkSize: 20
            });
            const [showSettings, setShowSettings] = React.useState(false);
            const [contentType, setContentType] = React.useState('text');
            const [ipAddresses, setIpAddresses] = React.useState([]);
            const [isMobile, setIsMobile] = React.useState(window.innerWidth < 768);
            const simplemdeRef = React.useRef(null);

            // 检测设备是否为移动设备
            React.useEffect(() => {
                const handleResize = () => {
                    setIsMobile(window.innerWidth < 768);
                };

                window.addEventListener('resize', handleResize);
                return () => window.removeEventListener('resize', handleResize);
            }, []);

            // 获取IP地址列表
            const fetchIpAddresses = async () => {
                try {
                    const response = await fetch('/api/ip-addresses');
                    const result = await response.json();
                    if (result.success && result.addresses) {
                        setIpAddresses(result.addresses);
                        // 如果当前settings中的IP不在地址列表中，使用第一个可用的IP
                        if (!result.addresses.includes(settings.ip) && result.addresses.length > 0) {
                            const newSettings = { ...settings, ip: result.addresses[0] };
                            setSettings(newSettings);
                        }
                    }
                } catch (error) {
                    console.error('获取IP地址失败:', error);
                }
            };

            // 获取成员列表
            const fetchMembers = async () => {
                try {
                    const response = await fetch('/api/members');
                    const result = await response.json();
                    if (result.success) {
                        setMembers(result.data || []);
                    }
                } catch (error) {
                    console.error('获取成员列表失败:', error);
                }
            };

            React.useEffect(() => {
                // 初始化时获取IP地址列表
                fetchIpAddresses();

                // 初始化时获取成员列表
                fetchMembers();

                // 初始化 Markdown 编辑器
                if (!simplemdeRef.current && document.getElementById("markdownEditor")) {
                    simplemdeRef.current = new SimpleMDE({
                        element: document.getElementById("markdownEditor"),
                        toolbar: ["bold", "italic", "heading", "|", "quote", "code",
                            "unordered-list", "ordered-list", "|", "link",
                            "image", "table", "|", "preview"],
                        placeholder: "输入 Markdown 格式的文本...",
                        spellChecker: false,
                        autosave: {
                            enabled: true,
                            uniqueId: "markdownEditor",
                            delay: 1000,
                        },
                    });
                }

                // 初始化 QR Code
                try {
                    const qrcodeElement = document.getElementById('qrcode');
                    if (qrcodeElement) {
                        qrcodeElement.innerHTML = ''; // 清除旧的二维码
                        new QRCode(qrcodeElement, {
                            text: `http://${settings.ip}:${settings.port}`,
                            width: 128,
                            height: 128,
                            colorDark: '#000',
                            colorLight: '#fff',
                            correctLevel: QRCode.CorrectLevel.H
                        });
                    }
                } catch (error) {
                    console.error('QR Code initialization failed:', error);
                }

                // 初始化 WebSocket 连接
                initWebSocket();
            }, [settings.ip, settings.port]); // 当IP或端口变化时重新初始化

            // WebSocket 初始化
            const initWebSocket = () => {
                if (!settings || !settings.ip || !settings.port) return;

                const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                const host = window.location.hostname;
                const ws = new WebSocket(`${protocol}//${host}:${settings.port}`);

                ws.onmessage = (event) => {
                    try {
                        const message = JSON.parse(event.data);
                        console.log('收到WebSocket消息:', message);

                        switch (message.type) {
                            case 'files':
                                setFiles(message.data);
                                break;
                            case 'fileAdded':
                                setFiles(prev => [message.data, ...prev]);
                                break;
                            case 'fileRemoved':
                                setFiles(prev => prev.filter(f => f.id !== message.data));
                                break;
                            case 'fileUpdated':
                                setFiles(prev => prev.map(file =>
                                    file.id === message.data.id ? message.data : file
                                ));
                                break;
                            case 'members':
                                console.log('更新成员列表:', message.data);
                                setMembers(message.data || []);
                                break;
                            default:
                                console.log('未知消息类型:', message.type);
                        }
                    } catch (error) {
                        console.error('处理WebSocket消息出错:', error);
                    }
                };

                ws.onopen = () => {
                    console.log('WebSocket连接已建立');
                };

                ws.onclose = () => {
                    console.log('WebSocket连接已关闭，将尝试重连...');
                    setTimeout(initWebSocket, 3000);
                };

                ws.onerror = (error) => {
                    console.error('WebSocket 连接错误:', error);
                };
            };

            // 处理文件上传
            const handleFileUpload = async (event) => {
                event.preventDefault();
                const formData = new FormData(event.target);

                try {
                    const response = await fetch('/api/upload', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();
                    if (result.success) {
                        toast.success('文件上传成功');
                        event.target.reset();
                    } else {
                        toast.error('上传失败: ' + result.message);
                    }
                } catch (error) {
                    toast.error('上传出错');
                }
            };

            // 处理文本分享
            const handleTextShare = async (event) => {
                event.preventDefault();
                const content = contentType === 'markdown'
                    ? simplemdeRef.current.value()
                    : document.getElementById('messageInput').value;

                if (!content.trim()) {
                    toast.warning(`请输入要分享的${contentType === 'markdown' ? 'Markdown' : '文本'}`);
                    return;
                }

                try {
                    const response = await fetch('/api/text', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: content, contentType })
                    });

                    const result = await response.json();
                    if (result.success) {
                        toast.success('内容分享成功');
                        if (contentType === 'markdown') {
                            simplemdeRef.current.value('');
                        } else {
                            document.getElementById('messageInput').value = '';
                        }
                    } else {
                        toast.error('分享失败: ' + result.message);
                    }
                } catch (error) {
                    toast.error('分享出错');
                }
            };

            // 处理文件删除
            const handleDelete = async (id) => {
                if (!confirm('确定要删除这个项目吗？')) return;

                try {
                    const response = await fetch(`/api/files/${id}`, {
                        method: 'DELETE'
                    });

                    const result = await response.json();
                    if (result.success) {
                        toast.success('删除成功');
                    } else {
                        toast.error('删除失败: ' + result.message);
                    }
                } catch (error) {
                    toast.error('删除出错');
                }
            };

            // 处理文本编辑
            const handleEdit = async (id, content) => {
                try {
                    const response = await fetch(`/api/text/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content })
                    });

                    const result = await response.json();
                    if (result.success) {
                        toast.success('编辑成功');
                        // 更新本地文件列表
                        setFiles(prev => prev.map(file =>
                            file.id === id ? result.data : file
                        ));
                    } else {
                        toast.error('编辑失败: ' + result.message);
                    }
                } catch (error) {
                    toast.error('编辑出错');
                }
            };

            // 处理设置保存
            const handleSaveSettings = async () => {
                const form = document.getElementById('settingsForm');
                const formData = new FormData(form);
                const data = Object.fromEntries(formData);

                data.port = parseInt(data.port);
                data.chunkSize = parseInt(data.chunkSize);
                data.authEnable = formData.has('authEnable');

                try {
                    const response = await fetch('/api/settings', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();
                    if (result.success) {
                        toast.success('设置已保存');
                        setShowSettings(false);

                        if (result.requireRelogin) {
                            toast.info('已启用密码保护，即将跳转到登录页面...');
                            setTimeout(() => window.location.href = '/login', 1500);
                        } else if (
                            data.port !== settings.port ||
                            data.ip !== settings.ip
                        ) {
                            toast.info('IP或端口已修改，页面将重新加载...');
                            setTimeout(() => window.location.reload(), 1500);
                        }
                    } else {
                        toast.error('保存设置失败: ' + result.message);
                    }
                } catch (error) {
                    toast.error('保存设置出错');
                }
            };

            return (
                <div className="container mx-auto py-6 px-4">
                    {/* 头部 */}
                    <header className="flex justify-between items-center mb-6 pb-3 border-b border-gray-200">
                        <h1 className="text-2xl font-bold text-gray-800"><%= title %></h1>
                        <div className="flex items-center">
                            <span className="bg-gray-200 text-gray-700 px-3 py-1 rounded-md text-sm mr-3">
                                {settings.ip}:{settings.port}
                            </span>
                            <button
                                className="text-xl hover:bg-gray-100 w-8 h-8 flex items-center justify-center rounded-full transition"
                                onClick={() => setShowSettings(true)}
                                title="设置"
                            >
                                ⚙️
                            </button>
                        </div>
                    </header>

                    {/* 左右两栏布局 */}
                    <div className="flex flex-col md:flex-row gap-6">
                        {/* 左侧栏 - 上传区域 */}
                        <div className={`md:w-1/3 lg:w-1/4 ${isMobile ? "" : "sticky top-4 self-start"}`}>
                            <div className="bg-white rounded-lg shadow-sm p-4 mb-4">
                                <h2 className="text-lg font-semibold mb-3">上传文件</h2>
                                <form onSubmit={handleFileUpload}>
                                    <div className="mb-3">
                                        <input
                                            type="file"
                                            name="file"
                                            id="fileInput"
                                            className="w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4
                                            file:rounded file:border-0 file:text-sm file:bg-blue-50 file:text-blue-700
                                            hover:file:bg-blue-100 cursor-pointer"
                                        />
                                    </div>
                                    <button
                                        type="submit"
                                        className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition text-sm"
                                    >
                                        上传
                                    </button>
                                </form>
                            </div>

                            <div className="bg-white rounded-lg shadow-sm p-4 mb-4">
                                <h2 className="text-lg font-semibold mb-3">分享文本</h2>
                                <form onSubmit={handleTextShare}>
                                    <textarea
                                        id="messageInput"
                                        className="w-full border rounded p-2 mb-3 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                                        rows={isMobile ? 2 : 3}
                                        placeholder="输入要分享的文本..."
                                    ></textarea>
                                    <button
                                        type="submit"
                                        className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition text-sm"
                                    >
                                        分享
                                    </button>
                                </form>
                            </div>

                            {/* 二维码 */}
                            <div className="bg-white rounded-lg shadow-sm p-4 text-center">
                                <div id="qrcode" className="flex justify-center mb-2"></div>
                                <p className="text-sm text-gray-600">扫描二维码访问此文件共享服务</p>
                            </div>
                        </div>

                        {/* 右侧栏 - 文件列表 */}
                        <div className="md:w-2/3 lg:w-3/4">
                            <FileList files={files} onDelete={handleDelete} onEdit={handleEdit} />
                            <MembersList members={members} />
                        </div>
                    </div>

                    {/* 设置模态框 */}
                    <Modal show={showSettings} onHide={() => setShowSettings(false)}>
                        <Modal.Header closeButton>
                            <Modal.Title>服务设置</Modal.Title>
                        </Modal.Header>
                        <Modal.Body>
                            <Form id="settingsForm">
                                <Form.Group className="mb-3">
                                    <Form.Label>上传路径</Form.Label>
                                    <Form.Control
                                        type="text"
                                        name="uploadPath"
                                        defaultValue={settings.uploadPath}
                                    />
                                </Form.Group>

                                <Form.Group className="mb-3">
                                    <Form.Label>端口号</Form.Label>
                                    <Form.Control
                                        type="number"
                                        name="port"
                                        defaultValue={settings.port}
                                    />
                                </Form.Group>

                                <Form.Group className="mb-3">
                                    <Form.Label>IP 地址</Form.Label>
                                    <Form.Select
                                        name="ip"
                                        value={settings.ip}
                                        onChange={(e) => setSettings({ ...settings, ip: e.target.value })}
                                    >
                                        {ipAddresses.map(ip => (
                                            <option key={ip} value={ip}>{ip}</option>
                                        ))}
                                    </Form.Select>
                                </Form.Group>

                                <Form.Check
                                    type="checkbox"
                                    id="authEnable"
                                    name="authEnable"
                                    label="启用密码保护"
                                    defaultChecked={settings.authEnable}
                                    className="mb-3"
                                />

                                {settings.authEnable && (
                                    <Form.Group className="mb-3">
                                        <Form.Label>访问密码</Form.Label>
                                        <Form.Control
                                            type="text"
                                            name="password"
                                            defaultValue={settings.password}
                                        />
                                    </Form.Group>
                                )}

                                <Form.Group className="mb-3">
                                    <Form.Label>分片大小 (MB)</Form.Label>
                                    <Form.Control
                                        type="number"
                                        name="chunkSize"
                                        defaultValue={settings.chunkSize}
                                    />
                                </Form.Group>
                            </Form>
                        </Modal.Body>
                        <Modal.Footer>
                            <Button variant="secondary" onClick={() => setShowSettings(false)}>
                                取消
                            </Button>
                            <Button variant="primary" onClick={handleSaveSettings}>
                                保存设置
                            </Button>
                        </Modal.Footer>
                    </Modal>
                </div>
            );
        }

        // 渲染应用
        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>

</html>