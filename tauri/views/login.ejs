<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- React 和 ReactDOM -->
    <script src="/js/react/react.production.min.js"></script>
    <script src="/js/react/react-dom.production.min.js"></script>

    <!-- Babel -->
    <script src="/js/react/babel.min.js"></script>

    <!-- React Bootstrap -->
    <link rel="stylesheet" href="/css/bootstrap5.min.css">
    <script src="/js/react/react-bootstrap.min.js"></script>

    <!-- Toast 样式 -->
    <link href="/css/toast.css" rel="stylesheet">

    <style>
        .login-container {
            max-width: 400px;
            margin: 100px auto;
        }

        .login-title {
            text-align: center;
            margin-bottom: 30px;
        }
    </style>
</head>

<body>
    <div id="root"></div>

    <script src="/js/toast.js"></script>

    <script type="text/babel">
        const { Container, Card, Form, Button } = ReactBootstrap;

        function LoginPage() {
            const handleSubmit = async (event) => {
                event.preventDefault();
                const password = event.target.password.value;

                if (!password) {
                    toast.warning('请输入密码');
                    return;
                }

                try {
                    const response = await fetch('/api/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ password })
                    });

                    const result = await response.json();
                    if (result.success) {
                        // 设置 cookie
                        document.cookie = `token=${result.token}; path=/`;
                        toast.success('登录成功');
                        setTimeout(() => window.location.href = '/', 1000);
                    } else {
                        toast.error('登录失败：' + result.message);
                    }
                } catch (error) {
                    toast.error('登录出错');
                }
            };

            return (
                <Container className="login-container">
                    <Card>
                        <Card.Body>
                            <h2 className="login-title">登录</h2>
                            <Form onSubmit={handleSubmit}>
                                <Form.Group className="mb-3">
                                    <Form.Label>请输入访问密码</Form.Label>
                                    <Form.Control
                                        type="password"
                                        name="password"
                                        placeholder="输入访问密码..."
                                        autoFocus
                                    />
                                </Form.Group>
                                <div className="d-grid">
                                    <Button variant="primary" type="submit">
                                        登录
                                    </Button>
                                </div>
                            </Form>
                        </Card.Body>
                    </Card>
                </Container>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<LoginPage />);
    </script>
</body>

</html>